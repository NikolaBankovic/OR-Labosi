{
  "openapi": "3.1.1",
  "info": {
    "title": "Igraci Liverpoola API",
    "version": "1.0"
  },
  "paths": {
    "/api/player/{id}": {
      "get": {
        "summary": "Get player by ID",
        "description": "Returns a single player resource by ID",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the player",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched player object",
            "schema": {
              "$ref": "#/definitions/Player"
            }
          },
          "400": {
            "description": "Player with the provided ID doesn't exist"
          },
          "404": {
            "description": "Player not found"
          }
        }
      },
      "put": {
        "summary": "Update player by ID",
        "description": "Updates a player's information",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the player",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Updated player object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/Player"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Player successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/Player"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Player not found"
          }
        }
      },
      "delete": {
        "summary": "Delete player by ID",
        "description": "Deletes a player from the database",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the player",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player successfully deleted"
          },
          "400": {
            "description": "Invalid ID"
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    },
    "/api/player": {
      "get": {
        "summary": "Get all players",
        "description": "Returns all players",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Fetch successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Player"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a new player",
        "description": "Creates a new player record",
        "requestBody": {
          "description": "Player object to be added",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/Player"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Player successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/Player"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  },
  "definitions": {
    "Player": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "ime": {
          "type": "string"
        },
        "prezime": {
          "type": "string"
        },
        "pozicija": {
          "type": "string"
        },
        "broj_dresa": {
          "type": "integer"
        },
        "godine": {
          "type": "integer"
        },
        "visina": {
          "type": "number",
          "format": "float"
        },
        "tezina": {
          "type": "number",
          "format": "float"
        },
        "drzava": {
          "type": "string"
        },
        "godina_pridruzivanja": {
          "type": "integer"
        }
      }
    }
  }
}
